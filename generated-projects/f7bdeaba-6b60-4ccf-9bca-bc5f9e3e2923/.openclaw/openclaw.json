{
  "meta": {
    "lastTouchedVersion": "2026.2.12",
    "lastTouchedAt": "2026-02-17T17:02:18.136Z"
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "anthropic/claude-3-5-sonnet"
      },
      "workspace": "./newsbot",
      "compaction": {
        "mode": "safeguard"
      }
    },
    "list": [
      {
        "id": "newsbot",
        "name": "News Summarizer",
        "workspace": "./newsbot"
      }
    ]
  },
  "channels": {
    "telegram": {
      "enabled": true,
      "botToken": "${TELEGRAM_BOT_TOKEN}",
      "dmPolicy": "pairing"
    }
  },
  "crons": [
    {
      "id": "daily-news-brief",
      "schedule": "0 9 * * *",
      "agentId": "newsbot",
      "prompt": "Fetch the latest world news from BBC, Reuters, and NPR. Highlight the top 3-5 major global stories. Provide a concise summary for each and format it nicely for Telegram. Send this summary to the user.",
      "channel": "telegram"
    }
  ],
  "plugins": {
    "entries": {
      "telegram": {
        "enabled": true
      }
    }
  }
}
